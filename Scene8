n = int(input("Enter number of product IDs: "))
ids = list(map(int, input("Enter IDs: ").split()))
divisible = []
for i in range(n - 1, -1, -1):
    if ids[i] % 5 == 0:
        divisible.append(ids[i])
if len(divisible) == 0:
    print(-1)
else:
    for d in divisible:
        print(d, end=" ")
